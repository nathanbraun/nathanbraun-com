---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  isHome?: boolean;
  noindex?: boolean;
  math?: boolean;
}

const { title, description = '', isHome = false, noindex = false, math = false } = Astro.props;
---

<BaseLayout title={title} description={description} headerType={isHome ? 'home' : 'page'} noindex={noindex}>
  {math && <link slot="head" rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.19.0/dist/katex.min.css" />}
  <article class="markdown-content mb-12">
    <slot />
  </article>
</BaseLayout>

<style is:global>
  .markdown-content h1 {
    @apply text-3xl font-bold font-header mb-4;
  }
  .markdown-content h2 {
    @apply text-2xl font-bold font-header mt-8 mb-4;
  }
  .markdown-content h3 {
    @apply text-xl font-bold font-header mt-6 mb-3;
  }
  .markdown-content p {
    @apply mb-4 mx-0;
  }
  .markdown-content a {
    @apply underline text-blue-600;
  }
  .markdown-content a:visited {
    @apply text-purple-800;
  }
  .markdown-content ul {
    @apply list-disc ml-10 mb-2 mr-6 md:mr-0;
  }
  .markdown-content ol {
    @apply list-decimal ml-10 mb-2 mr-6 md:mr-0;
  }
  .markdown-content li {
    @apply mb-1;
  }
  .markdown-content blockquote {
    @apply md:border md:border-solid md:rounded md:bg-white md:shadow-lg md:italic md:my-6 px-6 py-4;
  }
  .markdown-content img {
    @apply object-scale-down w-full;
  }
  .markdown-content code {
    @apply bg-gray-200 px-1 rounded text-base;
  }
  .markdown-content .toc {
    @apply mb-6;
  }
  .markdown-content .toc-title {
    @apply font-bold font-header cursor-pointer select-none;
  }
  .markdown-content .toc details[open] .toc-title {
    @apply mb-2;
  }
  .markdown-content .toc ul {
    @apply mb-0;
  }
  .markdown-content .toc li {
    @apply mb-0;
  }
  .markdown-content pre {
    @apply bg-gray-200 p-4 rounded overflow-x-auto mb-4;
  }
  .markdown-content pre code {
    @apply bg-transparent p-0;
  }
  .markdown-content strong {
    @apply font-bold;
  }
  .markdown-content em {
    @apply italic;
  }
  .markdown-content hr {
    @apply my-8 border-gray-300;
  }

  /* Jupyter notebook pages (generated by scripts/nb2md.py) */
  .markdown-content .nb-input,
  .markdown-content .nb-output {
    @apply relative mb-4;
  }
  .markdown-content .nb-input::before,
  .markdown-content .nb-output::before {
    @apply block text-xs font-header uppercase tracking-wide text-gray-400 mb-1;
  }
  .markdown-content .nb-input::before {
    content: 'In';
  }
  .markdown-content .nb-output::before {
    content: 'Out';
  }
  .markdown-content .nb-input pre {
    @apply mb-0;
  }
  .markdown-content .nb-output {
    @apply overflow-x-auto;
  }
  .markdown-content .nb-output pre {
    @apply bg-white border border-gray-200 text-sm;
  }
  .markdown-content .nb-output img {
    @apply bg-white;
  }
  .markdown-content table.dataframe {
    @apply text-sm bg-white border-collapse whitespace-nowrap mb-2;
  }
  .markdown-content table.dataframe th,
  .markdown-content table.dataframe td {
    @apply px-2 py-1 text-right border-b border-gray-200;
  }
  .markdown-content table.dataframe thead th {
    @apply font-bold border-gray-400;
  }
  .markdown-content table.dataframe tbody th {
    @apply font-bold;
  }
  .markdown-content table.dataframe tbody tr:nth-child(odd) {
    @apply bg-gray-50;
  }
  .markdown-content .math-display {
    @apply overflow-x-auto mb-4;
  }
</style>
